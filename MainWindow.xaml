<Window x:Class="EigongCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nine Sols - Eigong Skin/Effect Customizer" Height="800" Width="1200" Background="#1E1E1E">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
            <EventSetter Event="KeyDown" Handler="NumBox_KeyDown"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：路徑管理與圖片列表 -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <DockPanel Margin="0,0,0,10">
                    <TextBlock x:Name="TxtLang" Text="語言 / Language:" Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="BtnLang" Content="English" Width="90" HorizontalAlignment="Right" Click="BtnLang_Click" Background="#444" Foreground="White"/>
                </DockPanel>

                <TextBlock x:Name="TxtBodyPath" Text="易公本體資料夾:" Foreground="#DDD" FontSize="11" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBodyBox" Background="#2A2A2A" Foreground="White" VerticalContentAlignment="Center" IsReadOnly="True" FontSize="11"/>
                    <Button Grid.Column="1" Content="..." Click="BrowseBody_Click" Background="#3A3A3A" Foreground="White"/>
                    <Button Grid.Column="2" x:Name="BtnLoadBody" Content="載入" Click="BtnLoadBody_Click" Background="#0E639C" Foreground="White"/>
                </Grid>

                <TextBlock x:Name="TxtEffectPath" Text="攻擊特效資料夾:" Foreground="#DDD" FontSize="11" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathEffectBox" Background="#2A2A2A" Foreground="White" VerticalContentAlignment="Center" IsReadOnly="True" FontSize="11"/>
                    <Button Grid.Column="1" Content="..." Click="BrowseEffect_Click" Background="#3A3A3A" Foreground="White"/>
                    <Button Grid.Column="2" x:Name="BtnLoadEffect" Content="載入" Click="BtnLoadEffect_Click" Background="#0E639C" Foreground="White"/>
                </Grid>

                <TextBlock x:Name="TxtOtherPath" Text="其他資料夾:" Foreground="#DDD" FontSize="11" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathOtherBox" Background="#2A2A2A" Foreground="White" VerticalContentAlignment="Center" IsReadOnly="True" FontSize="11"/>
                    <Button Grid.Column="1" Content="..." Click="BrowseOther_Click" Background="#3A3A3A" Foreground="White"/>
                    <Button Grid.Column="2" x:Name="BtnLoadOther" Content="載入" Click="BtnLoadOther_Click" Background="#0E639C" Foreground="White"/>
                </Grid>

                <TextBlock x:Name="TxtOutputPath" Text="自訂輸出資料夾:" Foreground="#00FFCC" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathOutputBox" Background="#2A2A2A" Foreground="White" VerticalContentAlignment="Center" IsReadOnly="True" FontSize="11"/>
                    <Button Grid.Column="1" Content="..." Click="BrowseOutput_Click" Background="#3A3A3A" Foreground="White"/>
                    <Button Grid.Column="2" x:Name="BtnOpenOutput" Content="📂" Click="BtnOpenOutput_Click" Background="#2E7D32" Foreground="White"/>
                </Grid>

                <Separator Background="#333" Margin="0,0,0,8"/>
            </StackPanel>

            <ListBox x:Name="FileListBox" SelectionChanged="FileListBox_SelectionChanged" Background="#252526" Foreground="White" BorderBrush="#3F3F46"/>
        </DockPanel>

        <!-- 中間：即時預覽（可用滴管取色） -->
        <Border x:Name="PreviewBorder" Grid.Column="1" BorderBrush="#3F3F46" BorderThickness="1" Background="#141414"
                MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- 右側：調色盤面板 -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtSec1" Text="1. 原圖色彩取樣" Foreground="Yellow" FontWeight="Bold" Margin="0,0,0,6"/>

                <ToggleButton x:Name="BtnPicker" Content="🎯 滴管（在預覽圖上點選 / 拖曳）" Click="BtnPicker_Click"
                              Height="30" Margin="0,0,0,6" Background="#3A3A3A" Foreground="White"/>

                <Button x:Name="BtnCompare" Content="👁 按住顯示原圖" Height="30" Margin="0,0,0,6"
                        Background="#5D4037" Foreground="White"
                        PreviewMouseLeftButtonDown="BtnCompare_Down"
                        PreviewMouseLeftButtonUp="BtnCompare_Up"
                        MouseLeave="BtnCompare_Up"/>

                <TextBlock x:Name="TxtPriorityHint" Text="（清單越上面優先權越高）" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                <ListBox x:Name="RuleList" Height="130" Margin="0,0,0,6" Background="#252526" BorderBrush="#3F3F46"
                         SelectionChanged="RuleList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RuleCheck_Click"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Rectangle Width="50" Height="16" Fill="{Binding SrcBrush}" Stroke="#777"/>
                                <TextBlock Text="  →  " Foreground="White"/>
                                <Rectangle Width="50" Height="16" Fill="{Binding TgtBrush}" Stroke="#777"/>
                                <TextBlock Text="{DynamicResource ProtectText}" Foreground="#FFD54F" VerticalAlignment="Center"
                                           Visibility="{Binding Exclude, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnAddRule" Grid.Column="0" Content="＋ 新增顏色" Click="BtnAddRule_Click" Margin="0,0,4,0" Background="#3A3A3A" Foreground="White"/>
                    <Button x:Name="BtnDelRule" Grid.Column="1" Content="－ 刪除選取" Click="BtnDelRule_Click" Margin="0,0,4,0" Background="#3A3A3A" Foreground="White"/>
                    <Button x:Name="BtnMoveUp" Grid.Column="2" Content="▲" Click="BtnMoveUp_Click" Margin="0,0,4,0" Background="#3A3A3A" Foreground="White"/>
                    <Button x:Name="BtnMoveDown" Grid.Column="3" Content="▼" Click="BtnMoveDown_Click" Background="#3A3A3A" Foreground="White"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnExport" Grid.Column="0" Content="💾 匯出設定" Click="BtnExport_Click" Margin="0,0,4,0" Background="#2E7D32" Foreground="White"/>
                    <Button x:Name="BtnImport" Grid.Column="1" Content="📂 匯入設定" Click="BtnImport_Click" Background="#1565C0" Foreground="White"/>
                </Grid>

                <CheckBox x:Name="ChkExclude" Content="🛡 排除模式：保護這個顏色，不被替換"
                          Click="ChkExclude_Click" Foreground="#FFD54F" Margin="0,0,0,8"/>

                <!-- 原色 R -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderSrcR, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderSrcR" Maximum="255" Value="180" ValueChanged="Slider_ValueChanged"/>

                <!-- 原色 G -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderSrcG, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderSrcG" Maximum="255" Value="25" ValueChanged="Slider_ValueChanged"/>

                <!-- 原色 B -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderSrcB, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderSrcB" Maximum="255" Value="25" ValueChanged="Slider_ValueChanged"/>

                <Separator Margin="0,12" Background="#333"/>

                <TextBlock x:Name="TxtSec2" Text="2. 替換目標色彩" Foreground="LightGreen" FontWeight="Bold" Margin="0,0,0,6"/>
                <Button x:Name="BtnRandom" Content="🎲 隨機顏色" Click="BtnRandom_Click"
                        Height="26" Margin="0,0,0,6" Background="#6A1B9A" Foreground="White"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTexture" Content="🖼 使用圖片當基底" Click="BtnTexture_Click" Height="26" Margin="0,0,4,0" Background="#00695C" Foreground="White"/>
                    <Button x:Name="BtnClearTexture" Grid.Column="1" Content="✖" Click="BtnClearTexture_Click" Height="26" Background="#3A3A3A" Foreground="White"/>
                </Grid>
                <TextBlock x:Name="TxtTexInfo" Foreground="#80CBC4" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <!-- 目標色 R -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="R:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderTgtR, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderTgtR" Maximum="255" Value="0" ValueChanged="Slider_ValueChanged"/>

                <!-- 目標色 G -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="G:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderTgtG, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderTgtG" Maximum="255" Value="180" ValueChanged="Slider_ValueChanged"/>

                <!-- 目標色 B -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="B:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderTgtB, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderTgtB" Maximum="255" Value="255" ValueChanged="Slider_ValueChanged"/>

                <Rectangle x:Name="TargetColorPreview" Height="25" Margin="0,6,0,0" Stroke="#555" RadiusX="3" RadiusY="3"/>

                <Separator Margin="0,12" Background="#333"/>

                <TextBlock x:Name="TxtSec3" Text="3. 容許度與光影調整" Foreground="Cyan" FontWeight="Bold" Margin="0,0,0,6"/>

                <!-- 容許度 -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTol" Foreground="White" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderTol, Path=Value, StringFormat={}{0:F0}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderTol" Maximum="250" Minimum="10" Value="100" ValueChanged="Slider_ValueChanged"/>

                <!-- 光影增益 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBright" Foreground="White" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Style="{StaticResource NumBox}"
                             Text="{Binding ElementName=SliderBright, Path=Value, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <Slider x:Name="SliderBright" Maximum="3.0" Minimum="0.5" Value="1.1" ValueChanged="Slider_ValueChanged"/>

                <Button x:Name="BtnReset" Content="↺ 恢復預設值" Click="BtnReset_Click"
                        Height="30" Margin="0,15,0,0" Background="#4E342E" Foreground="White"/>

                <Button x:Name="BtnBatch" Content="⚡ 批次處理並輸出全部圖片 ⚡" Click="BtnBatchProcess_Click"
                        Height="45" Margin="0,10,0,0" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14"/>

                <TextBlock x:Name="StatusText" Text="就緒" Foreground="#AAA" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>